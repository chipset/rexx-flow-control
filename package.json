{
  "name": "rexx-control-flow",
  "displayName": "REXX Control Flow",
  "description": "Visualize and export control-flow graphs for REXX programs.",
  "version": "0.1.8",
  "publisher": "TMcQ",
  "repository": {
    "type": "git",
    "url": "https://github.com/chipset/rexx-flow-control.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "rexx",
    "control flow",
    "mainframe",
    "graph"
  ],
  "activationEvents": [
    "onLanguage:rexx",
    "onLanguage:REXX",
    "onCommand:rexxFlow.showControlGraph",
    "onCommand:rexxFlow.exportGraphJson",
    "onCommand:rexxFlow.exportDot",
    "onCommand:rexxFlow.exportExcalidraw"
  ],
  "icon": "images/icon.png",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rexxFlow.showControlGraph",
        "category": "REXX Control Flow",
        "title": "Generate REXX Control Flow"
      },
      {
        "command": "rexxFlow.exportGraphJson",
        "category": "REXX Control Flow",
        "title": "Export REXX Control Flow to JSON"
      },
      {
        "command": "rexxFlow.exportDot",
        "category": "REXX Control Flow",
        "title": "Export REXX Control Flow to DOT"
      },
      {
        "command": "rexxFlow.exportExcalidraw",
        "category": "REXX Control Flow",
        "title": "Export REXX Control Flow to Excalidraw"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rexxFlow.showControlGraph",
          "group": "navigation@1",
          "when": "editorLangId == rexx || editorLangId == REXX"
        }
      ]
    },
    "configuration": {
      "title": "REXX Control Flow",
      "properties": {
        "rexxFlow.customCssFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional path to a `.css` file used to override the control-flow webview styling. Relative paths resolve from the current workspace folder.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "lint": "echo 'No lint configured'",
    "test": "node --test"
  },
  "files": [
    "extension.js",
    "parser.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "package.json",
    "images/icon.png"
  ],
  "license": "MIT"
}
